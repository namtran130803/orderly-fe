FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

ARG VITE_API_URL=/api
ARG VITE_PUSHER_KEY=
ARG VITE_PUSHER_USE_VITE_PROXY=true
ARG VITE_PUSHER_WS_PORT=443

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_PUSHER_KEY=$VITE_PUSHER_KEY
ENV VITE_PUSHER_USE_VITE_PROXY=$VITE_PUSHER_USE_VITE_PROXY
ENV VITE_PUSHER_WS_PORT=$VITE_PUSHER_WS_PORT

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
