# API — dùng proxy Vite trong dev (xem vite.config.ts)
VITE_API_URL=/api

# Soketi — KEY khớp PUSHER_APP_KEY backend
VITE_PUSHER_KEY=orderly-key
# true = WSS qua cùng origin Vite (/app → Soketi :6001), bắt buộc khi npm run dev + HTTPS
VITE_PUSHER_USE_VITE_PROXY=true
VITE_PUSHER_WS_PORT=5173
# Chỉ khi USE_VITE_PROXY=false (FE http, nối thẳng Soketi):
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=6001
VITE_PUSHER_FORCE_TLS=false
