# Dùng relative URL để Vite proxy chuyển tiếp /api → backend
VITE_API_URL=/api

# Soketi — KEY khớp PUSHER_APP_KEY (orderly-be/.env)
VITE_PUSHER_KEY=orderly-key
# WS qua Vite proxy /app (bắt buộc khi FE HTTPS). Tắt nếu FE chạy http thuần:
VITE_PUSHER_USE_VITE_PROXY=true
VITE_PUSHER_WS_PORT=5173
# Chỉ dùng khi VITE_PUSHER_USE_VITE_PROXY=false:
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=6001
VITE_PUSHER_FORCE_TLS=false
